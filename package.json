    "lint-staged": "^15.0.0",
    "http-server": "^14.1.0",
    "webpack-bundle-analyzer": "^4.10.0",
    "karma": "^6.4.0",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.0",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "jasmine-core": "^5.0.0",
    "@testing-library/angular": "^14.0.0",
