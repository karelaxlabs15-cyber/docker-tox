{
  "name": "angular-advanced-app",
  "version": "18.0.0",
  "description": "Advanced Angular application with NgRx, PWA, Testing, and Security",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --coverage --ci",
    "lint": "eslint . --ext .ts",
    "e2e": "cypress open",
    "e2e:ci": "cypress run",
    "analyze": "ng build --stats-json && webpack-bundle-analyzer dist/angular-advanced-app/stats.json"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.0.0",
    "@angular/common": "^18.0.0",
    "@angular/compiler": "^18.0.0",
    "@angular/core": "^18.0.0",
    "@angular/forms": "^18.0.0",
    "@angular/platform-browser": "^18.0.0",
    "@angular/platform-browser-dynamic": "^18.0.0",
    "@angular/pwa": "^18.0.0",
    "@angular/router": "^18.0.0",
    "@angular/service-worker": "^18.0.0",
    "@ngrx/store": "^18.0.0",
    "@ngrx/effects": "^18.0.0",
    "@ngrx/entity": "^18.0.0",
    "@ngrx/store-devtools": "^18.0.0",
    "@ngrx/router-store": "^18.0.0",
    "@ngrx/schematics": "^18.0.0",
    "@ngxs/store": "^18.0.0",
    "@ngxs/devtools-plugin": "^18.0.0",
    "@ngxs/logger-plugin": "^18.0.0",
    "akita": "^11.0.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "^0.14.0",
    "immer": "^10.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "lodash": "^4.17.21",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.0.0",
    "@angular/cli": "^18.0.0",
    "@angular/compiler-cli": "^18.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.0.0",
    "ts-jest": "^29.1.0",
